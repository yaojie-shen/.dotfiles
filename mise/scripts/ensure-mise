#!/usr/bin/env bash
# Source this file, then call ensure_mise. No Python, Homebrew, or root needed.
set -euo pipefail
ensure_mise() {
  local version=2026.10.15 candidate current platform asset digest actual temp target
  candidate="${MISE_BIN:-$(command -v mise || true)}"
  [[ -n "$candidate" ]] || candidate="$HOME/.local/bin/mise"
  if [[ -x "$candidate" ]]; then
    current="$("$candidate" version | head -n 1)"
    current="${current%% *}"
    if awk -v v="$current" 'BEGIN {split(v,a,"."); exit !(a[1]>2026 || (a[1]==2026 && (a[2]>10 || (a[2]==10 && a[3]>=15))))}'; then
      MISE_BIN="$candidate"; export MISE_BIN; return
    fi
    [[ -z "${MISE_BIN:-}" ]] || { echo "mise >= $version required: $candidate" >&2; return 1; }
  fi
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64) platform=linux-x64-musl; digest=5daa5f70c1588bb27ffecb275b46dbafcab0f6fc93a893138ba4d8cae6074b60 ;;
    Linux/aarch64|Linux/arm64) platform=linux-arm64-musl; digest=823b94a7425c4781d475357cb2064bfafddc13cf66b7f2927b65d96f49bbe73c ;;
    Darwin/x86_64) platform=macos-x64; digest=ea45cc6e787d412deb8e069eec57875c71863e33a36acf69dd59791c27c9c073 ;;
    Darwin/arm64) platform=macos-arm64; digest=826c4833fa7437a63f6027b86bc10c8b61b1163dc793c03ecde92f68ad167890 ;;
    *) echo 'Supported platforms: Linux/macOS on x86_64/arm64' >&2; return 1 ;;
  esac
  command -v curl >/dev/null || { echo 'curl is required to download mise' >&2; return 1; }
  target="${MISE_INSTALL_DIR:-$HOME/.local/bin}/mise"
  mkdir -p "$(dirname "$target")"
  temp="$(mktemp "${target}.download.XXXXXX")"
  asset="mise-v${version}-${platform}"
  echo "Downloading mise $version ($platform)" >&2
  if ! curl -fLsS --retry 3 --connect-timeout 15 --max-time 300 "https://github.com/jdx/mise/releases/download/v${version}/${asset}" -o "$temp"; then
    rm -f "$temp"; return 1
  fi
  if command -v sha256sum >/dev/null; then actual="$(sha256sum "$temp")";
  elif command -v shasum >/dev/null; then actual="$(shasum -a 256 "$temp")";
  else echo 'sha256sum or shasum is required' >&2; rm -f "$temp"; return 1; fi
  if [[ "${actual%% *}" != "$digest" ]]; then
    echo 'mise checksum mismatch; download discarded' >&2; rm -f "$temp"; return 1
  fi
  chmod +x "$temp"; mv -f "$temp" "$target"
  MISE_BIN="$target"; export MISE_BIN
}

#!/usr/bin/env bash
set -euo pipefail
# Repositories themselves are managed by [bootstrap.repos]. Keep their tracked
# profiles pristine; enable the old plugin set through Bash-it's own command.
if [[ ! -f "$HOME/.bash_it/bash_it.sh" ]]; then
  echo 'Incomplete Bash-it checkout: missing bash_it.sh' >&2; exit 1
fi
if [[ ! -d "$HOME/.bash_it/enabled" ]]; then
  "$HOME/.bash_it/install.sh" --no-modify-config
  BASH_IT="$HOME/.bash_it" bash --noprofile --norc -c '
    source "$BASH_IT/bash_it.sh"
    bash-it enable plugin tmux git history-search history-substring-search autojump gitstatus history alias-completion
  '
fi

#!/usr/bin/env bash
# Optional external inhouse repo; expose it through the existing private layout.
set -euo pipefail
root="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
if [[ -n "${DOTFILES_CUSTOM_ROOT:-}" ]]; then
  [[ -d "$DOTFILES_CUSTOM_ROOT" ]] || { echo "Missing DOTFILES_CUSTOM_ROOT: $DOTFILES_CUSTOM_ROOT" >&2; exit 1; }
  custom="$(cd "$DOTFILES_CUSTOM_ROOT" && pwd -P)"
  target="$root/persistent/custom"
  if [[ -d "$target" && "$(cd "$target" && pwd -P)" == "$custom" ]]; then exit 0; fi
  if [[ -e "$target" && ! -L "$target" ]]; then
    echo "Refusing to replace existing private directory: $target" >&2; exit 1
  fi
  mkdir -p "$root/persistent"
  [[ ! -L "$target" ]] || rm "$target"
  ln -s "$custom" "$target"
fi

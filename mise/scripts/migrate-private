#!/usr/bin/env python3
"""One-time, conservative Dotbot link/create migration. Runtime needs no YAML."""
import json
from pathlib import Path, PurePosixPath
import shlex
import sys

try:
    import yaml
except ImportError:
    sys.exit('One-time migration needs PyYAML: uv run --with PyYAML python3 ' + ' '.join(shlex.quote(x) for x in sys.argv))

if len(sys.argv) != 2:
    sys.exit('Usage: migrate-private /path/to/private/install.conf.yaml')
source = Path(sys.argv[1]).resolve()
root = source.parent
out = root / 'mise.toml'
helper = root / 'mise-prepare.sh'
manifest = root / 'mise-persistent.tsv'
for file in [out, helper, manifest]:
    if file.exists() or file.is_symlink():
        sys.exit(f'Refusing to overwrite {file}')
blocks = yaml.safe_load(source.read_text())
if not isinstance(blocks, list):
    sys.exit('Expected a Dotbot instruction list')
links, guarded, dirs = [], [], []

def validate_home_path(path):
    if path.startswith('/') or '..' in PurePosixPath(path).parts:
        sys.exit('Home-relative paths must stay inside HOME: ' + path)


for block in blocks:
    if not isinstance(block, dict):
        sys.exit('Unsupported Dotbot instruction')
    for action, value in block.items():
        if action == 'defaults':
            if value != {'link': {'create': True, 'relink': True}}:
                sys.exit('Nonstandard defaults need manual migration')
        elif action == 'create':
            if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
                sys.exit('Only a list of directory paths is supported for create')
            for directory in value:
                if directory.startswith('/'):
                    sys.exit('Absolute create paths need manual migration: ' + directory)
                if directory.startswith('~/'):
                    validate_home_path(directory[2:])
                elif directory.startswith('~') and directory != '~':
                    sys.exit('Named-user home paths need manual migration')
            dirs.extend(value)
        elif action == 'link':
            for target, rule in value.items():
                if not isinstance(target, str) or not target.startswith('~/'):
                    sys.exit('Only home-relative targets are supported')
                validate_home_path(target[2:])
                if rule is None:
                    rule = {'path': target[2:]}
                if isinstance(rule, str):
                    rule = {'path': rule}
                if not isinstance(rule, dict) or set(rule) - {'path', 'if'}:
                    sys.exit('Link options other than path/standard preservation guard need manual migration')
                src = rule.get('path', target[2:])
                if not isinstance(src, str) or any(c in src + target for c in '\t\r\n'):
                    sys.exit('Invalid link path')
                condition = rule.get('if')
                if condition:
                    home_path = '$HOME/' + target[2:]
                    expected = f'[ ! -e "{home_path}" ] || [ -L "{home_path}" ]'
                    if condition != expected:
                        sys.exit('Nonstandard link condition needs manual migration')
                    guarded.append(('link', target[2:], src))
                else:
                    links.append((target, src))
        else:
            sys.exit(f'Unsupported action {action!r}; migrate manually before changing any files')
# All input is validated before writing. Keep the original YAML for comparison.
script = '#!/usr/bin/env bash\nset -euo pipefail\nprivate="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"\ncd "$private"\n'
for directory in dirs:
    if directory == '~':
        argument = '"$HOME"'
    elif directory.startswith('~/'):
        argument = '"$HOME"/' + shlex.quote(directory[2:])
    else:
        argument = shlex.quote(directory)
    script += 'mkdir -p -- ' + argument + '\n'
if guarded:
    script += 'bash "${1:?public dotfiles root required}/mise/scripts/guarded-links" "$private/mise-persistent.tsv" "$private"\n'
helper.write_text(script)
helper.chmod(0o755)
manifest.write_text(''.join('\t'.join(x) + '\n' for x in guarded))
config = '# Migrated from install.conf.yaml; original retained for review.\n'
config += '[vars]\ndotfiles_private_root = "{{config_source | canonicalize | dirname}}"\n\n[bootstrap.hooks]\npre-dotfiles = \'bash "{{vars.dotfiles_private_root}}/mise-prepare.sh" "{{vars.dotfiles_root}}"\'\n\n[dotfiles]\n'
for target, src in links:
    config += f'{json.dumps(target)} = {json.dumps(src)}\n'
out.write_text(config)
print(f'Created {out}, {helper.name}, {manifest.name}; review these in the private repository.')

#!/usr/bin/env bash

declare -A osInfo
osInfo[/etc/redhat-release]=yum
osInfo[/etc/arch-release]=pacman
osInfo[/etc/gentoo-release]=emerge
osInfo[/etc/SuSE-release]=zypp
osInfo[/etc/debian_version]=apt-get
osInfo[/etc/alpine-release]=apk

# Determine linux distribution
for f in "${!osInfo[@]}"
do
  if [[ -f $f ]];then
      pkg_manager=${osInfo[$f]}
  fi
done

case "$pkg_manager" in
  apt-get)
    sudo apt-get update

    packages=(
      zsh fish rsync tmux aria2 nano git-lfs iputils-ping
      # System monitoring
      nvtop htop speedometer atop
      # Required by some LSP server for neovim
      npm python3-venv
      # Required by neovim telescope, optional but useful.
      fd-find ripgrep
      tree pv pigz
      # Useful for JSON processing from cli
      jq
    )

    available_packages=()
    for package in "${packages[@]}"; do
      if apt-cache show "$package" 2>/dev/null | grep -q '^Package: '; then
        available_packages+=("$package")
      else
        echo "Skipping unavailable package: $package" >&2
      fi
    done

    if ((${#available_packages[@]} > 0)); then
      sudo apt-get install -y "${available_packages[@]}"
    fi
    ;;
  *)
    echo "Distribution not supported."
    ;;
esac

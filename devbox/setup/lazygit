#!/usr/bin/env bash

set -Eeuo pipefail

ACTION="install"
WITH_DELTA=1
DELTA_VERSION="0.20.1"
LAZYGIT_VERSION="${LAZYGIT_VERSION:-latest}"
INSTALL_DIR="${LAZYGIT_INSTALL_DIR:-${HOME}/.local/bin}"
INSTALL_DIR_SET="${LAZYGIT_INSTALL_DIR:+yes}"
TMP_DIR=""

_devbox_setup_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -f "$_devbox_setup_dir/../lib/import.bash" ]]; then
  printf '%s\n' "Error: Devbox importer not found: $_devbox_setup_dir/../lib/import.bash" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$_devbox_setup_dir/../lib/import.bash"
import output platform
unset _devbox_setup_dir

cleanup() {
  [[ -z "$TMP_DIR" ]] || rm -rf "$TMP_DIR"
}
trap cleanup EXIT

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Install lazygit, a terminal UI for git.

Behavior:
  - macOS: manages lazygit exclusively through an existing Homebrew installation.
  - Linux: downloads the official prebuilt binary and verifies its SHA-256 checksum.
  - Optionally installs delta for side-by-side diffs; failure is non-fatal.
  - Leaves delta and ~/.config/lazygit untouched on uninstall.

Options:
  -h, --help              Show this help message
  -u, --uninstall         Uninstall lazygit using the platform's install method
  --upgrade               Upgrade lazygit and refresh the bundled delta version
  --without-delta         Skip the optional delta installation
  --version <VERSION>     Linux only: specific release (default: latest)
  --install-dir <DIR>     Linux only: install directory (default: $INSTALL_DIR)

Examples:
  devbox setup lazygit
  devbox setup lazygit --upgrade
  devbox setup lazygit --uninstall
EOF
}

manage_homebrew() {
  local brew_cmd brew_prefix existing_bin installed="no"

  if [[ "$LAZYGIT_VERSION" != "latest" || -n "$INSTALL_DIR_SET" ]]; then
    error "On macOS, Homebrew manages the version and install location. Remove LAZYGIT_VERSION/LAZYGIT_INSTALL_DIR overrides and Linux-only options."
    return 1
  fi

  brew_cmd="$(command -v brew || true)"
  if [[ -z "$brew_cmd" ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
      brew_cmd="/opt/homebrew/bin/brew"
    elif [[ -x /usr/local/bin/brew ]]; then
      brew_cmd="/usr/local/bin/brew"
    else
      error "Homebrew is required on macOS. Install Homebrew first, then rerun this command."
      return 1
    fi
  fi

  brew_prefix="$("$brew_cmd" --prefix)"
  if "$brew_cmd" list --formula lazygit >/dev/null 2>&1; then
    installed="yes"
  fi

  if [[ "$ACTION" == "uninstall" ]]; then
    if [[ "$installed" == "yes" ]]; then
      "$brew_cmd" uninstall --formula lazygit
      success "lazygit uninstalled via Homebrew; configuration was left unchanged"
    else
      warning "lazygit is not installed via Homebrew"
    fi
    return 0
  fi

  # Do not silently add a second installation or delete an unmanaged binary.
  for existing_bin in "$HOME/.local/bin/lazygit" "$(command -v lazygit || true)"; do
    [[ -n "$existing_bin" ]] || continue
    if [[ -e "$existing_bin" || -L "$existing_bin" ]]; then
      if [[ "$installed" == "yes" && "$existing_bin" -ef "$brew_prefix/bin/lazygit" ]]; then
        continue
      fi
      error "Existing lazygit outside this Homebrew installation: $existing_bin. Remove or migrate it before rerunning; no changes were made."
      return 1
    fi
  done

  if [[ "$installed" == "no" ]]; then
    "$brew_cmd" install --formula lazygit
  elif [[ "$ACTION" == "upgrade" ]]; then
    "$brew_cmd" upgrade --formula lazygit
  else
    success "lazygit is already installed via Homebrew"
    return 0
  fi
  success "lazygit managed via Homebrew: $brew_prefix/bin/lazygit"
}

require_value() {
  local option="${1:-}"
  local value="${2:-}"

  if [[ -z "$value" || "$value" == -* ]]; then
    error "Missing value for $option"
    return 1
  fi
}

release_platform() {
  local os arch
  os="$(detect_os)"
  arch="$(detect_arch)"

  case "$os" in
  macos) os="darwin" ;;
  linux) ;;
  *)
    error "Unsupported OS: $os. lazygit provides binaries for macOS and Linux only."
    return 1
    ;;
  esac

  case "$arch" in
  arm64 | x86_64) ;;
  *)
    error "Unsupported architecture: $arch. lazygit provides x86_64 and arm64 binaries only."
    return 1
    ;;
  esac

  printf '%s_%s\n' "$os" "$arch"
}

checksum() {
  local file="$1"

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    error "sha256sum or shasum is required to verify the lazygit download"
    return 1
  fi
}

check_requirements() {
  local missing=()

  command -v curl >/dev/null 2>&1 || missing+=("curl")
  command -v tar >/dev/null 2>&1 || missing+=("tar")

  if [[ ${#missing[@]} -gt 0 ]]; then
    error "Missing required commands: ${missing[*]}"
    return 1
  fi
}

resolve_version() {
  if [[ "$LAZYGIT_VERSION" != "latest" ]]; then
    printf '%s\n' "${LAZYGIT_VERSION#v}"
    return 0
  fi

  local tag
  tag="$(curl -fsSL --retry 3 --connect-timeout 10 --max-time 30 \
    https://api.github.com/repos/jesseduffield/lazygit/releases/latest |
    sed -n 's/.*"tag_name" *: *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1)"

  if [[ -z "$tag" ]]; then
    error "Could not determine the latest lazygit version"
    return 1
  fi
  printf '%s\n' "$tag"
}

install() {
  local bin_path platform version archive archive_path checksums_path
  local release_url expected actual extracted_bin

  bin_path="${INSTALL_DIR%/}/lazygit"
  if [[ -x "$bin_path" && "$ACTION" != "upgrade" ]]; then
    success "lazygit is already installed: $bin_path ($("$bin_path" --version 2>/dev/null | head -1))"
    return 0
  fi

  check_requirements
  platform="$(release_platform)"
  version="$(resolve_version)"
  release_url="https://github.com/jesseduffield/lazygit/releases/download/v${version}"

  archive="lazygit_${version}_${platform}.tar.gz"
  TMP_DIR="$(mktemp -d)"
  archive_path="$TMP_DIR/$archive"
  checksums_path="$TMP_DIR/checksums.txt"

  info "Downloading lazygit ${version} for ${platform}..."
  if ! curl -fsSL --retry 3 --connect-timeout 10 --max-time 180 \
    "$release_url/$archive" -o "$archive_path"; then
    error "Failed to download $release_url/$archive"
    return 1
  fi
  if ! curl -fsSL --retry 3 --connect-timeout 10 --max-time 30 \
    "$release_url/checksums.txt" -o "$checksums_path"; then
    error "Failed to download $release_url/checksums.txt"
    return 1
  fi

  expected="$(awk -v name="$archive" '$2 == name || $2 == "*" name {print $1; exit}' "$checksums_path")"
  actual="$(checksum "$archive_path")"
  if [[ -z "$expected" ]]; then
    error "No checksum published for $archive"
    return 1
  fi
  if [[ "$actual" != "$expected" ]]; then
    error "lazygit checksum verification failed"
    return 1
  fi

  tar -xzf "$archive_path" -C "$TMP_DIR" lazygit
  extracted_bin="$TMP_DIR/lazygit"
  if [[ ! -f "$extracted_bin" ]]; then
    error "lazygit binary was not found in the downloaded archive"
    return 1
  fi

  mkdir -p "$INSTALL_DIR"
  chmod +x "$extracted_bin"
  mv -f "$extracted_bin" "$bin_path"
  success "lazygit installed successfully: $bin_path"
}

# Keep delta optional: every failing step returns to the warning-only caller.
install_delta() (
  local target expected archive version_dir delta_tmp actual
  local delta_bin="${INSTALL_DIR%/}/delta"
  if [[ "$(detect_os)" == "macos" ]]; then
    local brew_cmd
    brew_cmd="$(command -v brew || true)"
    [[ -n "$brew_cmd" ]] || brew_cmd="/opt/homebrew/bin/brew"
    [[ -x "$brew_cmd" ]] || brew_cmd="/usr/local/bin/brew"
    if "$brew_cmd" list --formula git-delta >/dev/null 2>&1; then
      [[ "$ACTION" != "upgrade" ]] || "$brew_cmd" upgrade --formula git-delta || return 1
    else
      "$brew_cmd" install --formula git-delta || return 1
    fi
    return 0
  fi
  if [[ "$ACTION" != "upgrade" ]]; then
    if [[ -x "$delta_bin" ]] && "$delta_bin" --version >/dev/null 2>&1; then
      success "delta is already installed: $delta_bin"
      return 0
    fi
    if command -v delta >/dev/null 2>&1 && delta --version >/dev/null 2>&1; then
      success "delta is already available on PATH"
      return 0
    fi
  fi
  case "$(detect_arch)" in
    x86_64)
      target=x86_64-unknown-linux-musl
      expected=69dcb4043f55c29118f408c6efd30115e0a4e0a6709253343b8c8fa814ab4a31
      ;;
    arm64)
      target=aarch64-unknown-linux-gnu
      expected=da7f4338f593572ff426ae153e0870e2fdc72729416eff551b40cdeb67940db8
      ;;
    *) return 1 ;;
  esac
  check_requirements || return 1
  delta_tmp="$(mktemp -d)" || return 1
  trap 'rm -rf "$delta_tmp"' EXIT
  version_dir="delta-${DELTA_VERSION}-${target}"
  archive="${version_dir}.tar.gz"
  info "Installing optional delta ${DELTA_VERSION} for ${target}..."
  curl -fsSL --retry 2 --connect-timeout 10 --max-time 120 \
    "https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/${archive}" \
    -o "$delta_tmp/$archive" || return 1
  actual="$(checksum "$delta_tmp/$archive")" || return 1
  if [[ "$actual" != "$expected" ]]; then
    error "delta checksum verification failed"
    return 1
  fi
  tar -xzf "$delta_tmp/$archive" -C "$delta_tmp" "$version_dir/delta" || return 1
  chmod +x "$delta_tmp/$version_dir/delta" || return 1
  "$delta_tmp/$version_dir/delta" --version || return 1
  mkdir -p "$INSTALL_DIR" || return 1
  mv -f "$delta_tmp/$version_dir/delta" "$delta_bin" || return 1
  success "Optional delta installed: $delta_bin"
)

uninstall() {
  local bin_path="${INSTALL_DIR%/}/lazygit"

  if [[ ! -f "$bin_path" ]]; then
    warning "lazygit is not installed at $bin_path"
    return 0
  fi

  rm -f "$bin_path"
  success "lazygit uninstalled: $bin_path"
  warning "lazygit configuration in ~/.config/lazygit was left unchanged"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -u | --uninstall)
    ACTION="uninstall"
    shift
    ;;
  --upgrade)
    ACTION="upgrade"
    shift
    ;;
  --without-delta)
    WITH_DELTA=0
    shift
    ;;
  --version)
    require_value "$1" "${2:-}"
    LAZYGIT_VERSION="$2"
    shift 2
    ;;
  --install-dir)
    require_value "$1" "${2:-}"
    INSTALL_DIR="$2"
    INSTALL_DIR_SET="yes"
    shift 2
    ;;
  *)
    error "Unknown option: $1"
    usage
    exit 1
    ;;
  esac
done

os="$(detect_os)"
if [[ "$os" == "macos" ]]; then
  manage_homebrew
else
  case "$ACTION" in
    uninstall) uninstall ;;
    *) install ;;
  esac
fi

if [[ "$ACTION" != "uninstall" && "$WITH_DELTA" == 1 ]]; then
  if ! install_delta; then
    warning "Optional delta installation failed; lazygit is ready to use with its normal diff."
  fi
fi

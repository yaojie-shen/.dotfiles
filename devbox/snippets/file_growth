set_screen_theme "$screen_theme"

usage() {
  local cmd
  cmd="$(basename "$0")"

  cat <<EOF
usage: ${cmd} [path] [options]

Continuously monitor growth/shrink speed. A file target counts completed lines;
a directory target counts files as before.
The smoothed speed uses EMA: smooth = alpha * current + (1 - alpha) * previous.

options:
  -e, --exec COMMAND   Count lines of COMMAND output instead of scanning a path
                       (runs via bash -c once per poll; stdout is piped to wc -l)
  -i, --interval SEC   Poll interval in seconds. Default: 1
  -a, --alpha VALUE    EMA smoothing alpha in (0, 1]. Lower is smoother. Default: 0.30
  -n, --name PATTERN   Directory only: match file basenames, e.g. '*.jpg'
  -r, --recursive      Directory only: count files recursively
  -p, --parallel N     Directory only: recursive workers. Default: 32; 0 uses find
  --include-dirs       Directory only: count directories too in non-recursive mode
  -t, --total N        Expected final count; show progress and ETA
                       Counts lines for a file or entries for a directory
  --samples N          Stop after N printed samples.
  --append             Use stable append output instead of the default interactive screen UI
  --history N          Rows to keep in screen mode. Default: 1000
  -h, --help           Show this help message and exit

screen UI keys:
  h / ?                Show all screen UI keys
  t                    Toggle the terminal theme
  Esc                  Close help panel only

During parallel recursive scans, the screen status shows folders as
scanned/discovered. The discovered total grows as workers find subdirectories.

examples:
  ${cmd} ./output.jsonl
  ${cmd} ./output.jsonl --total 100000
  ${cmd} ./outputs
  ${cmd} ./outputs --interval 2 --alpha 0.2
  ${cmd} ./outputs --name '*.jsonl'
  ${cmd} ./outputs --include-dirs
  ${cmd} ./outputs --total 100000
  ${cmd} ./outputs --append
  ${cmd} ./outputs --recursive --samples 10
  ${cmd} ./outputs --recursive -p 0
  ${cmd} -e 'hdfs dfs -ls hdfs://cluster/path/out' --interval 30
  ${cmd} -e 'hdfs dfs -ls hdfs://cluster/path/out' --total 44000000
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

count_target() {
  local count entry base

  # Custom counting command: count its output lines, like `<cmd> | wc -l`.
  # Failures fall through to a count of 0 rather than killing the monitor
  # (e.g. a transient hdfs error), matching the find fallbacks below.
  if [[ -n "$exec_cmd" ]]; then
    { bash -c "$exec_cmd" 2>/dev/null || true; } | wc -l | tr -d '[:space:]'
    return
  fi

  if [[ -f "$target" ]]; then
    LC_ALL=C wc -l < "$target" | tr -d '[:space:]'
    return
  fi

  if [[ "$recursive" -eq 1 ]]; then
    if [[ "$parallel" -gt 0 ]] && command -v python3 >/dev/null 2>&1; then
      python3 - "$target" "$name_pattern" "$parallel" "${scan_progress_file:-}" <<'PY'
import fnmatch
import multiprocessing as mp
import os
import sys
import threading

target, name_pattern, parallel, progress_file = sys.argv[1:]
parallel = int(parallel)
try:
    mp.set_start_method("fork")
except RuntimeError:
    pass

def worker(dir_queue, result_queue, folder_progress):
    count = 0
    while True:
        path = dir_queue.get()
        if path is None:
            dir_queue.task_done()
            break
        try:
            with os.scandir(path) as entries:
                for entry in entries:
                    try:
                        if entry.is_dir(follow_symlinks=False):
                            if folder_progress is not None:
                                with folder_progress.get_lock():
                                    folder_progress[1] += 1
                            dir_queue.put(entry.path)
                        elif entry.is_file(follow_symlinks=False):
                            if not name_pattern or fnmatch.fnmatchcase(entry.name, name_pattern):
                                count += 1
                    except OSError:
                        pass
        except OSError:
            pass
        finally:
            if folder_progress is not None:
                with folder_progress.get_lock():
                    folder_progress[0] += 1
            dir_queue.task_done()
    result_queue.put(count)

dir_queue = mp.JoinableQueue()
result_queue = mp.Queue()
folder_progress = mp.Array("Q", (0, 1)) if progress_file else None
progress_stop = threading.Event()

def write_progress():
    if folder_progress is None:
        return
    with folder_progress.get_lock():
        scanned, discovered = folder_progress[:]
    try:
        with open(progress_file + ".tmp", "w", encoding="ascii") as file:
            file.write(f"{scanned} {discovered}\n")
        os.replace(progress_file + ".tmp", progress_file)
    except OSError:
        pass

def report_progress():
    while not progress_stop.wait(0.1):
        write_progress()

processes = [
    mp.Process(target=worker, args=(dir_queue, result_queue, folder_progress))
    for _ in range(parallel)
]
for process in processes:
    process.start()
progress_thread = None
if progress_file:
    write_progress()
    progress_thread = threading.Thread(target=report_progress, daemon=True)
    progress_thread.start()
dir_queue.put(target)
dir_queue.join()
if progress_thread is not None:
    progress_stop.set()
    progress_thread.join()
    write_progress()
for _ in processes:
    dir_queue.put(None)
dir_queue.join()
total = 0
for _ in processes:
    total += result_queue.get()
for process in processes:
    process.join()
print(total)
PY
      return
    fi
    if [[ -n "$name_pattern" ]]; then
      { find "$target" -type f -name "$name_pattern" -print 2>/dev/null || true; } | wc -l | tr -d '[:space:]'
    else
      { find "$target" -type f -print 2>/dev/null || true; } | wc -l | tr -d '[:space:]'
    fi
    return
  fi

  if [[ -z "$name_pattern" ]]; then
    if [[ "$include_dirs" -eq 1 ]]; then
      LC_ALL=C ls -1A "$target" 2>/dev/null | wc -l | tr -d '[:space:]'
    else
      LC_ALL=C ls -1Ap "$target" 2>/dev/null | awk 'substr($0, length($0), 1) != "/" { n++ } END { print n + 0 }'
    fi
    return
  fi

  count=0
  shopt -s nullglob dotglob
  for entry in "$target"/*; do
    if [[ "$include_dirs" -eq 1 ]]; then
      [[ -f "$entry" || -d "$entry" ]] || continue
    else
      [[ -f "$entry" ]] || continue
    fi
    if [[ -n "$name_pattern" ]]; then
      base="$(basename "$entry")"
      [[ "$base" == $name_pattern ]] || continue
    fi
    ((count += 1))
  done
  shopt -u nullglob dotglob
  printf '%s\n' "$count"
}

parse_args() {
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -e | --exec)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        exec_cmd="$2"
        shift 2
        ;;
      -i | --interval)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        interval="$2"
        shift 2
        ;;
      -a | --alpha)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        alpha="$2"
        shift 2
        ;;
      -n | --name)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        name_pattern="$2"
        shift 2
        ;;
      -p | --parallel)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        parallel="$2"
        parallel_set=1
        shift 2
        ;;
      -r | --recursive)
        recursive=1
        shift
        ;;
      --include-dirs)
        include_dirs=1
        shift
        ;;
      -t | --total)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        total="$2"
        shift 2
        ;;
      --samples)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        samples="$2"
        shift 2
        ;;
      --append)
        ui="append"
        shift
        ;;
      --history)
        [[ "$#" -ge 2 ]] || die "$1 requires a value"
        history_limit="$2"
        shift 2
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -* )
        usage >&2
        die "unknown option: $1"
        ;;
      *)
        if [[ "$target_set" -eq 1 ]]; then
          usage >&2
          die "only one path is supported"
        fi
        target="$1"
        target_set=1
        shift
        ;;
    esac
  done

  [[ "$#" -eq 0 ]] || die "unexpected extra arguments: $*"
}

validate_args() {
  if [[ -n "$exec_cmd" ]]; then
    [[ "$target_set" -eq 0 ]] || die "--exec cannot be used with a path target"
    [[ "$recursive" -eq 0 ]] || die "--recursive cannot be used with --exec"
    [[ "$include_dirs" -eq 0 ]] || die "--include-dirs cannot be used with --exec"
    [[ -z "$name_pattern" ]] || die "--name cannot be used with --exec"
    [[ "$parallel_set" -eq 0 ]] || die "--parallel cannot be used with --exec"
  fi
  [[ -n "$target" ]] || die "path cannot be empty"
  [[ "$interval" =~ ^[1-9][0-9]*$ ]] || die "--interval must be a positive integer"
  [[ "$samples" =~ ^[0-9]+$ ]] || die "--samples must be a non-negative integer"
  [[ "$total" =~ ^[0-9]+$ ]] || die "--total must be a non-negative integer"
  [[ "$parallel" =~ ^[0-9]+$ ]] || die "--parallel must be a non-negative integer"
  [[ "$history_limit" =~ ^[1-9][0-9]*$ ]] || die "--history must be a positive integer"
  [[ "$ui" == "append" || "$ui" == "screen" ]] || die "internal error: unknown ui mode: $ui"
  if [[ "$ui" == "screen" && (! -t 0 || ! -t 1) ]]; then
    ui="append"
  fi
  awk -v a="$alpha" 'BEGIN { exit !(a > 0 && a <= 1) }' || die "--alpha must be in (0, 1]"
}

# Validate options whose meaning depends on the target type only after the
# target appears.
validate_target() {
  if [[ -f "$target" ]]; then
    [[ "$recursive" -eq 0 ]] || die "--recursive cannot be used with a file target"
    [[ "$include_dirs" -eq 0 ]] || die "--include-dirs cannot be used with a file target"
    [[ -z "$name_pattern" ]] || die "--name cannot be used with a file target"
    [[ "$parallel_set" -eq 0 ]] || die "--parallel cannot be used with a file target"
  elif [[ -d "$target" ]]; then
    [[ ! ( "$recursive" -eq 1 && "$include_dirs" -eq 1 ) ]] || die "--include-dirs cannot be used with --recursive"
  else
    die "path disappeared before monitoring could start: $target"
  fi
}

# Print the table header shared by append output and screen UI.
format_header() {
  if [[ "$total" -gt 0 ]]; then
    printf '%-8s %8s %12s %9s %9s %12s %12s %12s %12s' \
      "time" "scan_s" "count" "delta" "progress" "eta" "raw/s" "smooth/s" "smooth/min"
  else
    printf '%-8s %8s %12s %9s %12s %12s %12s' \
      "time" "scan_s" "count" "delta" "raw/s" "smooth/s" "smooth/min"
  fi
}

# Format an ETA from a remaining item count and per-second rate.
format_eta() {
  local remaining="$1"
  local rate="$2"

  awk -v remain="$remaining" -v rate="$rate" 'BEGIN {
    if (remain <= 0) {
      printf "done"
    } else if (rate <= 0) {
      printf "--"
    } else {
      sec = int(remain / rate + 0.5)
      day = int(sec / 86400)
      sec = sec % 86400
      hour = int(sec / 3600)
      sec = sec % 3600
      minute = int(sec / 60)
      second = sec % 60
      if (day > 0) {
        printf "%dd%02d:%02d:%02d", day, hour, minute, second
      } else {
        printf "%02d:%02d:%02d", hour, minute, second
      }
    }
  }'
}

# Format one already-computed sample row. This is intentionally side-effect free so
# append mode can print it directly and screen mode can store it in history_rows.
format_sample() {
  local scan_s="$1"
  local count="$2"
  local delta="$3"
  local raw="$4"
  local smooth="$5"
  local smooth_min="$6"
  local progress remaining eta

  if [[ "$total" -gt 0 ]]; then
    progress="$(awk -v c="$count" -v t="$total" 'BEGIN { printf "%.1f%%", c * 100 / t }')"
    remaining=$((total - count))
    eta="$(format_eta "$remaining" "$smooth")"
    printf '%-8s %8d %12d %+9d %9s %12s %12.4f %12.4f %12.2f' \
      "$(date +%H:%M:%S)" "$scan_s" "$count" "$delta" "$progress" "$eta" "$raw" "$smooth" "$smooth_min"
  else
    printf '%-8s %8d %12d %+9d %12.4f %12.4f %12.2f' \
      "$(date +%H:%M:%S)" "$scan_s" "$count" "$delta" "$raw" "$smooth" "$smooth_min"
  fi
}

# Print the colored intro used by both UI modes. In screen mode render_screen uses
# the same fields, but draws them inside the alternate screen.
print_intro() {
  local total_label="-" status_line keys_line
  [[ "$total" -gt 0 ]] && total_label="$total"
  printf '%sfile_growth%s %s%s%s\n' "$COLOR_BOLD" "$COLOR_RESET" "$COLOR_CYAN" "$target" "$COLOR_RESET"
  if [[ "$mode" == "file-lines" || "$mode" == "exec" ]]; then
    status_line="mode=${mode} interval=${interval}s alpha=${alpha} total=${total_label}"
  else
    status_line="mode=${mode} pattern=${name_pattern:-*} interval=${interval}s alpha=${alpha} total=${total_label} include_dirs=${include_dirs} parallel=${parallel}"
  fi
  printf '%s%s%s\n' "$COLOR_DIM" "$status_line" "$COLOR_RESET"
  keys_line="initial_count=${initial_count} initial_scan_s=${initial_scan_s}s scan=idle"
  printf '%s%s%s\n' "$COLOR_YELLOW" "$keys_line" "$COLOR_RESET"
}

# Update global sampling state from a completed count result.
#
# Inputs:
#   $1 scan duration in seconds
#   $2 counted item count
#   $3 scan completion time from date +%s
# Outputs via globals:
#   sample_line, smooth, prev_count, prev_time
update_sample_from_count() {
  local scan_s="$1"
  local now_count="$2"
  local now_time="$3"
  local dt delta raw smooth_min

  dt=$((now_time - prev_time))
  [[ "$dt" -gt 0 ]] || dt="$interval"
  delta=$((now_count - prev_count))

  raw="$(awk -v d="$delta" -v t="$dt" 'BEGIN { printf "%.4f", d / t }')"
  smooth="$(awk -v a="$alpha" -v r="$raw" -v s="$smooth" 'BEGIN { printf "%.4f", a * r + (1 - a) * s }')"
  smooth_min="$(awk -v s="$smooth" 'BEGIN { printf "%.2f", s * 60 }')"
  sample_line="$(format_sample "$scan_s" "$now_count" "$delta" "$raw" "$smooth" "$smooth_min")"

  current_scan_s="$scan_s"
  current_count="$now_count"
  current_delta="$delta"

  prev_count="$now_count"
  prev_time="$now_time"
}

# Synchronous sampling for the stable append mode. Do not call through command
# substitution: this function updates global EMA state used by the next sample.
sample_once() {
  local scan_start now_count now_time scan_s

  scan_start="$(date +%s)"
  now_count="$(count_target)"
  now_time="$(date +%s)"
  scan_s=$((now_time - scan_start))
  update_sample_from_count "$scan_s" "$now_count" "$now_time"
}

# Convert one async scan result into sample_line for screen mode. The first
# finished scan establishes a baseline so pre-existing files do not create an
# artificial initial speed spike.
format_scan_result() {
  local scan_s="$1"
  local now_count="$2"
  local now_time="$3"

  if [[ "$screen_has_baseline" -eq 0 ]]; then
    initial_count="$now_count"
    initial_scan_s="$scan_s"
    smooth="0.0000"
    sample_line="$(format_sample "$scan_s" "$now_count" 0 "0.0000" "$smooth" "0.00")"
    current_scan_s="$scan_s"
    current_count="$now_count"
    current_delta=0
    prev_count="$now_count"
    prev_time="$now_time"
    screen_has_baseline=1
    return
  fi

  update_sample_from_count "$scan_s" "$now_count" "$now_time"
}

# Start a background count for screen mode. The main UI loop keeps rendering and
# reading keys while this subshell writes one atomic result file.
start_async_scan() {
  [[ -n "${scan_pid:-}" ]] && return

  scan_status="running"
  scan_file="$(mktemp /tmp/file_growth_scan.XXXXXX)"
  scan_progress_file="${scan_file}.progress"
  scan_folders_scanned=0
  scan_folders_discovered=1
  (
    scan_start="$(date +%s)"
    scan_count="$(count_target)"
    scan_time="$(date +%s)"
    printf '%s %s %s\n' "$((scan_time - scan_start))" "$scan_count" "$scan_time" > "${scan_file}.tmp"
    mv "${scan_file}.tmp" "$scan_file"
  ) &
  scan_pid="$!"
}

# Refresh live folder progress published by the parallel recursive scanner.
# Returns success only when the displayed counters changed.
refresh_scan_progress() {
  local folders_scanned folders_discovered
  [[ "${scan_tracks_folders:-0}" -eq 1 ]] || return 1
  [[ -n "${scan_progress_file:-}" && -s "$scan_progress_file" ]] || return 1
  read -r folders_scanned folders_discovered < "$scan_progress_file"
  [[ "$folders_scanned" =~ ^[0-9]+$ && "$folders_discovered" =~ ^[1-9][0-9]*$ ]] || return 1
  if [[ "$folders_scanned" == "$scan_folders_scanned" && "$folders_discovered" == "$scan_folders_discovered" ]]; then
    return 1
  fi
  scan_folders_scanned="$folders_scanned"
  scan_folders_discovered="$folders_discovered"
}

# Collect a completed background count. Returns success only when sample_line has
# been refreshed and is ready to append to history_rows.
collect_async_scan() {
  local scan_s now_count now_time
  [[ -n "${scan_pid:-}" ]] || return 1

  if [[ ! -s "$scan_file" ]]; then
    if ! kill -0 "$scan_pid" 2>/dev/null; then
      wait "$scan_pid" 2>/dev/null || true
      scan_pid=""
      scan_status="error"
    fi
    return 1
  fi

  wait "$scan_pid" 2>/dev/null || true
  scan_pid=""
  refresh_scan_progress || true
  read -r scan_s now_count now_time < "$scan_file"
  rm -f "$scan_file" "$scan_file.tmp" "$scan_progress_file" "$scan_progress_file.tmp"
  scan_file=""
  scan_progress_file=""
  scan_status="idle"
  format_scan_result "$scan_s" "$now_count" "$now_time"
  return 0
}

# Stable default mode: synchronous count, sleep, append one row to stdout.
run_append() {
  local header_line

  print_intro
  header_line="$(format_header)"
  printf '%s%s%s\n' "$COLOR_BOLD$COLOR_BLUE" "$header_line" "$COLOR_RESET"

  while true; do
    sleep "$interval"
    sample_once
    printf '%s\n' "$sample_line"

    ((printed += 1))
    if [[ "$samples" -gt 0 && "$printed" -ge "$samples" ]]; then
      break
    fi
  done
}

# Parse one keyboard or terminal-protocol event from the shared PTY input.
# Theme reports must be consumed as a unit so their digits never become keys.
read_input_event() {
  local first next char sequence="" osc_regex

  input_event=""
  input_value=""
  read -rsn1 -t 1 first <&3 || return 1
  if [[ "$first" != $'\033' ]]; then
    input_event="key"
    input_value="$first"
    return 0
  fi

  # Bash 3.2 only supports whole-second read timeouts. Let the tty apply its
  # 100ms VTIME here so a standalone Esc stays responsive while CSI/OSC input
  # that is already buffered continues immediately.
  next="$(dd bs=1 count=1 <&3 2>/dev/null)"
  if [[ -z "$next" ]]; then
    input_event="key"
    input_value="$first"
    return 0
  fi

  if [[ "$next" == "[" ]]; then
    sequence=$'\033['
    while [[ "${#sequence}" -lt 32 ]] && read -rsn1 -t 1 char <&3; do
      sequence+="$char"
      [[ "$char" == [[:alpha:]~] ]] && break
    done
    case "$sequence" in
      $'\033[?997;1n')
        set_screen_theme "dark"
        input_event="theme"
        ;;
      $'\033[?997;2n')
        set_screen_theme "light"
        input_event="theme"
        ;;
      *)
        input_event="key"
        input_value="$sequence"
        ;;
    esac
    return 0
  fi

  if [[ "$next" == "]" ]]; then
    while [[ "${#sequence}" -lt 96 ]] && read -rsn1 -t 1 char <&3; do
      [[ "$char" == $'\a' ]] && break
      if [[ "$char" == $'\033' ]]; then
        if ! read -rsn1 -t 1 next <&3; then
          sequence+="$char"
          break
        fi
        if [[ "$next" == "\\" ]]; then
          break
        fi
        sequence+="$char$next"
      else
        sequence+="$char"
      fi
    done
    osc_regex='^11;rgb:([[:xdigit:]]{1,4})/([[:xdigit:]]{1,4})/([[:xdigit:]]{1,4})$'
    if [[ "$sequence" =~ $osc_regex ]]; then
      set_theme_from_rgb "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
      input_event="theme"
    else
      input_event="terminal"
    fi
    return 0
  fi

  input_event="key"
  input_value="${first}${next}"
}

# Classify an OSC 11 RGB response. Components may use 4, 8, 12, or 16 bits.
set_theme_from_rgb() {
  local red_hex="$1" green_hex="$2" blue_hex="$3"
  local red green blue red_max green_max blue_max detected_theme

  red=$((16#$red_hex))
  green=$((16#$green_hex))
  blue=$((16#$blue_hex))
  case "${#red_hex}" in 1) red_max=15 ;; 2) red_max=255 ;; 3) red_max=4095 ;; *) red_max=65535 ;; esac
  case "${#green_hex}" in 1) green_max=15 ;; 2) green_max=255 ;; 3) green_max=4095 ;; *) green_max=65535 ;; esac
  case "${#blue_hex}" in 1) blue_max=15 ;; 2) blue_max=255 ;; 3) blue_max=4095 ;; *) blue_max=65535 ;; esac
  detected_theme="$(awk -v r="$red" -v g="$green" -v b="$blue" \
    -v rm="$red_max" -v gm="$green_max" -v bm="$blue_max" \
    'BEGIN { print (0.299*r/rm + 0.587*g/gm + 0.114*b/bm > 0.5) ? "light" : "dark" }')"
  set_screen_theme "$detected_theme"
}

# Query the semantic scheme first, then fall back to the actual background.
query_screen_theme() {
  printf '\033[?996n'
  if read_input_event && [[ "$input_event" == "theme" ]]; then
    return 0
  fi
  printf '\033]11;?\033\\'
  if read_input_event && [[ "$input_event" == "theme" ]]; then
    return 0
  fi
  return 1
}

initialize_screen_theme() {
  local fallback="${COLORFGBG:-}"

  fallback="${fallback##*;}"

  if [[ "$fallback" =~ ^[0-9]+$ && "$fallback" -ge 8 ]]; then
    set_screen_theme "light"
  else
    set_screen_theme "dark"
  fi
  printf '\033[?2031h'
  query_screen_theme || true
}

# Enter alternate-screen mode and configure /dev/tty for non-blocking key reads.
setup_screen() {
  if { exec 3</dev/tty; } 2>/dev/null; then
    :
  elif { exec 3<&0; } 2>/dev/null; then
    :
  else
    die "interactive screen UI requires a terminal; use --append for stable append output"
  fi
  saved_stty="$(stty -g <&3 2>/dev/null || true)"
  trap 'cleanup_screen; exit 130' INT TERM
  trap 'cleanup_screen' EXIT
  trap 'screen_resized=1' WINCH
  printf '\033[?1049h'
  tput civis 2>/dev/null || true
  # VTIME gives the Esc continuation probe above a 100ms timeout; ordinary
  # event waiting still blocks efficiently in Bash's read builtin.
  stty -echo -icanon time 1 min 0 <&3 2>/dev/null || true
  initialize_screen_theme
}

# Restore terminal state and stop any in-flight async scan.
cleanup_screen() {
  trap - EXIT INT TERM
  if [[ -n "${scan_pid:-}" ]]; then
    kill "$scan_pid" 2>/dev/null || true
    wait "$scan_pid" 2>/dev/null || true
  fi
  if [[ -n "${scan_file:-}" ]]; then
    rm -f "$scan_file" "$scan_file.tmp"
  fi
  if [[ -n "${scan_progress_file:-}" ]]; then
    rm -f "$scan_progress_file" "$scan_progress_file.tmp"
  fi
  if [[ -n "${saved_stty:-}" ]]; then
    stty "$saved_stty" <&3 2>/dev/null || true
  fi
  exec 3<&- 2>/dev/null || true
  tput cnorm 2>/dev/null || true
  printf '\033[?2031l\033[?1049l'
}

# Return current terminal row count for screen layout; falls back to 24.
terminal_rows() {
  local size rows
  size="$(stty size <&3 2>/dev/null || true)"
  rows="${size%% *}"
  if [[ "$rows" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "$rows"
  else
    tput lines 2>/dev/null || printf '24'
  fi
}

# Return current terminal column count for screen layout; falls back to 80.
terminal_cols() {
  local size cols
  size="$(stty size <&3 2>/dev/null || true)"
  cols="${size##* }"
  if [[ "$cols" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "$cols"
  else
    tput cols 2>/dev/null || printf '80'
  fi
}

# Wait without assuming whether a missing target will become a file or a
# directory. Screen mode redraws a compact waiting view; append mode emits
# timestamped state changes suitable for logs.
wait_for_target() {
  local title_line status_line hint_line cols

  [[ -f "$target" || -d "$target" ]] && return 0

  if [[ "$ui" == "append" ]]; then
    printf '%sfile_growth%s %s%s%s\n' "$COLOR_BOLD" "$COLOR_RESET" "$COLOR_CYAN" "$target" "$COLOR_RESET"
    printf '%s %spath does not exist; waiting for a file or directory to appear%s\n' \
      "$(date +%H:%M:%S)" "$COLOR_YELLOW" "$COLOR_RESET"
    while [[ ! -f "$target" && ! -d "$target" ]]; do
      sleep 1
    done
    printf '%s %spath appeared; starting monitor%s\n' \
      "$(date +%H:%M:%S)" "$COLOR_GREEN" "$COLOR_RESET"
    return 0
  fi

  setup_screen
  cols="$(terminal_cols)"
  title_line="file_growth $target"
  status_line="path does not exist; waiting for a file or directory to appear"
  hint_line="watching continuously; press q to quit"
  printf '\033[?2026h'
  draw_screen_row 1 "$title_line" "${COLOR_BOLD}${COLOR_CYAN}file_growth${COLOR_RESET} ${COLOR_MUTED}${target}${COLOR_RESET}" "$cols"
  draw_screen_row 2 "$status_line" "${COLOR_YELLOW}${status_line}${COLOR_RESET}" "$cols"
  draw_screen_row 3 "$hint_line" "${COLOR_DIM}${hint_line}${COLOR_RESET}" "$cols"
  printf '\033[?2026l'
  while [[ ! -f "$target" && ! -d "$target" ]]; do
    if read_input_event; then
      if [[ "$input_event" == "theme" ]]; then
        printf '\033[?2026h'
        draw_screen_row 1 "$title_line" "${COLOR_BOLD}${COLOR_CYAN}file_growth${COLOR_RESET} ${COLOR_MUTED}${target}${COLOR_RESET}" "$cols"
        draw_screen_row 2 "$status_line" "${COLOR_YELLOW}${status_line}${COLOR_RESET}" "$cols"
        draw_screen_row 3 "$hint_line" "${COLOR_MUTED}${hint_line}${COLOR_RESET}" "$cols"
        printf '\033[?2026l'
      elif [[ "$input_event" == "key" && "$input_value" == "q" ]]; then
        cleanup_screen
        return 1
      fi
    fi
  done
  cleanup_screen
}

# Largest valid history offset for the current viewport height.
max_view_start() {
  local body_rows="$1"
  local row_count="${#history_rows[@]}"
  local max=$((row_count - body_rows))
  [[ "$max" -gt 0 ]] || max=0
  printf '%s\n' "$max"
}

# Keep selected_index and view_start in bounds while preserving htop-like follow
# behavior at the latest row.
clamp_selection() {
  local body_rows="$1"
  local row_count="${#history_rows[@]}"
  local max_start

  if [[ "$row_count" -le 0 ]]; then
    selected_index=-1
    view_start=0
    follow=1
    return
  fi

  if [[ "$follow" -eq 1 ]]; then
    selected_index=$((row_count - 1))
    view_start="$(max_view_start "$body_rows")"
    return
  fi

  if [[ "$selected_index" -lt 0 ]]; then
    selected_index=0
  elif [[ "$selected_index" -ge "$row_count" ]]; then
    selected_index=$((row_count - 1))
  fi

  if [[ "$selected_index" -lt "$view_start" ]]; then
    view_start="$selected_index"
  elif [[ "$selected_index" -ge $((view_start + body_rows)) ]]; then
    view_start=$((selected_index - body_rows + 1))
  fi

  max_start="$(max_view_start "$body_rows")"
  if [[ "$view_start" -lt 0 ]]; then
    view_start=0
  elif [[ "$view_start" -gt "$max_start" ]]; then
    view_start="$max_start"
  fi

  if [[ "$selected_index" -ge $((row_count - 1)) ]]; then
    follow=1
  fi
}

# Append one fixed-width cell to grid_visible/grid_colored.
append_grid_cell() {
  local text="$1"
  local color="$2"
  local width="$3"
  local padding

  [[ "$width" -gt 1 ]] || return
  if [[ "${#text}" -ge "$width" ]]; then
    text="${text:0:$((width - 1))}"
  fi
  printf -v padding '%*s' "$((width - ${#text}))" ''
  grid_visible+="${text}${padding}"
  grid_colored+="${color}${text}${padding}${COLOR_RESET}"
}

# Extend a colored row through the last safe terminal column without triggering
# autowrap. The metric columns stay compact while their section background spans
# the pane.
fill_grid_background() {
  local cols="$1"
  local background="$2"
  local padding_width padding

  padding_width=$((cols - 1 - ${#grid_visible}))
  [[ "$padding_width" -gt 0 ]] || return 0
  printf -v padding '%*s' "$padding_width" ''
  grid_visible+="$padding"
  grid_colored+="${background}${padding}${COLOR_RESET}"
}

# Build aligned label/value rows for live scan activity.
format_scan_activity() {
  local cols="$1"
  local status_color scan_time_display baseline_display field_count cell_width last_width

  status_color="$COLOR_YELLOW"
  [[ "$scan_status" == "idle" ]] && status_color="$COLOR_VALUE"
  [[ "$scan_status" == "error" ]] && status_color="$COLOR_RED"
  scan_time_display="--"
  [[ "$current_scan_s" =~ ^[0-9]+$ ]] && scan_time_display="${current_scan_s}s"
  baseline_display="pending"
  [[ "$initial_count" =~ ^[0-9]+$ ]] && baseline_display="${initial_count} (${initial_scan_s}s)"

  # Use the same compact column grid as the summary above. Keeping the fifth
  # slot empty makes SCAN/LAST/FOLDERS/BASELINE line up with
  # COUNT/PROGRESS/SMOOTH/ETA instead of spreading four fields across the pane.
  field_count=4
  [[ "$total" -gt 0 ]] && field_count=5
  cell_width=$(((cols - 1) / field_count))
  [[ "$cell_width" -le 24 ]] || cell_width=24
  last_width="$cell_width"

  grid_visible=""
  grid_colored=""
  append_grid_cell "SCAN" "$COLOR_BG_SCAN$COLOR_BOLD$COLOR_LABEL" "$cell_width"
  append_grid_cell "LAST" "$COLOR_BG_SCAN$COLOR_BOLD$COLOR_LABEL" "$cell_width"
  if [[ "${scan_tracks_folders:-0}" -eq 1 ]]; then
    append_grid_cell "FOLDERS" "$COLOR_BG_SCAN$COLOR_BOLD$COLOR_LABEL" "$cell_width"
  else
    append_grid_cell "" "$COLOR_BG_SCAN" "$cell_width"
  fi
  append_grid_cell "BASELINE" "$COLOR_BG_SCAN$COLOR_BOLD$COLOR_LABEL" "$last_width"
  if [[ "$total" -gt 0 ]]; then
    append_grid_cell "" "$COLOR_BG_SCAN" "$cell_width"
  fi
  fill_grid_background "$cols" "$COLOR_BG_SCAN"
  scan_labels_visible="$grid_visible"
  scan_labels_colored="$grid_colored"

  grid_visible=""
  grid_colored=""
  append_grid_cell "$scan_status" "$COLOR_BG_SCAN$status_color" "$cell_width"
  append_grid_cell "$scan_time_display" "$COLOR_BG_SCAN$COLOR_VALUE" "$cell_width"
  if [[ "${scan_tracks_folders:-0}" -eq 1 ]]; then
    append_grid_cell "${scan_folders_scanned}/${scan_folders_discovered}" "$COLOR_BG_SCAN$COLOR_VALUE" "$cell_width"
  else
    append_grid_cell "" "$COLOR_BG_SCAN" "$cell_width"
  fi
  append_grid_cell "$baseline_display" "$COLOR_BG_SCAN$COLOR_VALUE" "$last_width"
  if [[ "$total" -gt 0 ]]; then
    append_grid_cell "" "$COLOR_BG_SCAN" "$cell_width"
  fi
  fill_grid_background "$cols" "$COLOR_BG_SCAN"
  scan_values_visible="$grid_visible"
  scan_values_colored="$grid_colored"
}

# Format a screen table header that fits the current terminal width.
format_screen_header() {
  local cols="$1"
  if [[ "$total" -gt 0 && "$cols" -ge 122 ]] || [[ "$total" -eq 0 && "$cols" -ge 82 ]]; then
    format_header
  elif [[ "$total" -gt 0 && "$cols" -ge 71 ]] || [[ "$total" -eq 0 && "$cols" -ge 65 ]]; then
    if [[ "$total" -gt 0 ]]; then
      printf '%-8s %12s %9s %12s %12s %12s' "time" "count" "delta" "eta" "raw/s" "smooth/s"
    else
      printf '%-8s %12s %9s %12s %12s' "time" "count" "delta" "raw/s" "smooth/s"
    fi
  else
    printf '%-8s %12s %9s %12s' "time" "count" "delta" "smooth/s"
  fi
}

# Reformat a retained full sample row for the current terminal width.
format_screen_sample() {
  local line="$1"
  local cols="$2"
  local time scan_s count delta progress eta raw rate rate_min

  if [[ "$total" -gt 0 ]]; then
    read -r time scan_s count delta progress eta raw rate rate_min <<< "$line"
  else
    read -r time scan_s count delta raw rate rate_min <<< "$line"
    eta="--"
  fi

  if [[ "$total" -gt 0 && "$cols" -ge 122 ]] || [[ "$total" -eq 0 && "$cols" -ge 82 ]]; then
    printf '%s' "$line"
  elif [[ "$total" -gt 0 && "$cols" -ge 71 ]] || [[ "$total" -eq 0 && "$cols" -ge 65 ]]; then
    if [[ "$total" -gt 0 ]]; then
      printf '%-8s %12s %9s %12s %12s %12s' "$time" "$count" "$delta" "$eta" "$raw" "$rate"
    else
      printf '%-8s %12s %9s %12s %12s' "$time" "$count" "$delta" "$raw" "$rate"
    fi
  else
    printf '%-8s %12s %9s %12s' "$time" "$count" "$delta" "$rate"
  fi
}

# Replace one terminal row without printing a newline or triggering autowrap.
draw_screen_row() {
  local row="$1"
  local visible="$2"
  local colored="$3"
  local cols="$4"

  printf '\033[%d;1H\033[2K' "$row"
  if [[ "${#visible}" -ge "$cols" ]]; then
    printf '%.*s' "$((cols - 1))" "$visible"
  else
    printf '%s' "$colored"
  fi
}

# Redraw the whole alternate screen: summary, scan activity, history, and a
# fixed navigation footer.
render_screen() {
  local rows cols body_rows row_count max_start start end i frame_row selected_display follow_label
  local title_line config_line header_line footer_line footer_colored footer_left footer_left_colored footer_right footer_right_colored footer_padding row_text
  local count_display delta_display smooth_display eta_display remaining progress_display progress_pct bar_width filled_width fill empty field_count cell_width last_width
  local smooth_color change_color eta_color follow_color include_label scanner footer_base footer_key footer_quit
  local visible colored previous_visible previous_colored
  local force_redraw=0
  local -a frame_visible=()
  local -a frame_colored=()
  rows="$(terminal_rows)"
  cols="$(terminal_cols)"
  # Seven fixed rows at the top, one footer row, and an unused final row prevent
  # terminal scrolling when a printed line ends with a newline.
  body_rows=$((rows - 9))
  [[ "$body_rows" -gt 0 ]] || body_rows=1
  row_count="${#history_rows[@]}"

  clamp_selection "$body_rows"

  start="$view_start"
  end=$((start + body_rows))
  [[ "$end" -le "$row_count" ]] || end="$row_count"
  selected_display=0
  [[ "$selected_index" -ge 0 ]] && selected_display=$((selected_index + 1))
  follow_label="off"
  [[ "$follow" -eq 1 ]] && follow_label="on"
  max_start="$(max_view_start "$body_rows")"

  title_line="file_growth $target"
  frame_visible[0]="$title_line"
  frame_colored[0]="${COLOR_BOLD}${COLOR_CYAN}file_growth${COLOR_RESET} ${COLOR_MUTED}${target}${COLOR_RESET}"

  if [[ "$show_help" -eq 1 ]]; then
    frame_visible[2]="Screen UI keys"
    frame_colored[2]="${COLOR_BOLD}${COLOR_MAGENTA}Screen UI keys${COLOR_RESET}"
    frame_visible[3]="  h / ?              Toggle this help panel"
    frame_colored[3]="  ${COLOR_BOLD}h / ?${COLOR_RESET}              Toggle this help panel"
    frame_visible[4]="  q                  Close help panel; quit from monitor"
    frame_colored[4]="  ${COLOR_BOLD}q${COLOR_RESET}                  Close help panel; quit from monitor"
    frame_visible[5]="  Esc                Close help panel only"
    frame_colored[5]="  ${COLOR_BOLD}Esc${COLOR_RESET}                Close help panel only"
    frame_visible[6]="  k / Up             Scroll up to older rows"
    frame_colored[6]="  ${COLOR_BOLD}k / Up${COLOR_RESET}             Scroll up to older rows"
    frame_visible[7]="  j / Down           Scroll down to newer rows"
    frame_colored[7]="  ${COLOR_BOLD}j / Down${COLOR_RESET}           Scroll down to newer rows"
    frame_visible[8]="  PageUp / PageDown  Scroll one page"
    frame_colored[8]="  ${COLOR_BOLD}PageUp / PageDown${COLOR_RESET}  Scroll one page"
    frame_visible[9]="  g                  Jump to oldest retained row"
    frame_colored[9]="  ${COLOR_BOLD}g${COLOR_RESET}                  Jump to oldest retained row"
    frame_visible[10]="  G / End            Jump to latest row and follow new samples"
    frame_colored[10]="  ${COLOR_BOLD}G / End${COLOR_RESET}            Jump to latest row and follow new samples"
    frame_visible[11]="  t                  Toggle the terminal theme"
    frame_colored[11]="  ${COLOR_BOLD}t${COLOR_RESET}                  Toggle the terminal theme"
    frame_visible[12]="Press h, ?, or q to return to the monitor."
    frame_colored[12]="${COLOR_MUTED}Press h, ?, or q to return to the monitor.${COLOR_RESET}"
  else
    delta_display="--"
    smooth_display="--"
    eta_display="--"
    smooth_color="$COLOR_VALUE"
    change_color="$COLOR_VALUE"
    eta_color="$COLOR_VALUE"
    count_display="$current_count"
    if [[ "$current_count" =~ ^[0-9]+$ ]]; then
      printf -v delta_display '%+d' "$current_delta"
      smooth_display="${smooth}/s"
      [[ "$current_delta" -le 0 ]] || change_color="$COLOR_GREEN"
      [[ "$current_delta" -ge 0 ]] || change_color="$COLOR_RED"
      [[ "$smooth" != -* ]] || smooth_color="$COLOR_RED"
      if [[ "$total" -gt 0 ]]; then
        count_display="${current_count}/${total}"
        remaining=$((total - current_count))
        eta_display="$(format_eta "$remaining" "$smooth")"
        [[ "$eta_display" == "done" ]] && eta_color="$COLOR_GREEN"
      fi
    elif [[ "$total" -gt 0 ]]; then
      count_display="pending/${total}"
    fi

    field_count=4
    [[ "$total" -gt 0 ]] && field_count=5
    cell_width=$(((cols - 1) / field_count))
    [[ "$cell_width" -le 24 ]] || cell_width=24
    last_width="$cell_width"

    progress_display="pending"
    if [[ "$total" -gt 0 && "$current_count" =~ ^[0-9]+$ ]]; then
      progress_pct="$(awk -v c="$current_count" -v t="$total" 'BEGIN { printf "%.1f%%", c * 100 / t }')"
      progress_display="$progress_pct"
      bar_width=$((cell_width - ${#progress_pct} - 4))
      if [[ "$bar_width" -ge 4 ]]; then
        filled_width="$(awk -v c="$current_count" -v t="$total" -v w="$bar_width" 'BEGIN {
          filled = int(c * w / t + 0.5)
          if (filled < 0) filled = 0
          if (filled > w) filled = w
          print filled
        }')"
        printf -v fill '%*s' "$filled_width" ''
        printf -v empty '%*s' "$((bar_width - filled_width))" ''
        fill="${fill// /#}"
        empty="${empty// /-}"
        progress_display="${progress_pct} [${fill}${empty}]"
      fi
    fi

    grid_visible=""
    grid_colored=""
    append_grid_cell "COUNT" "$COLOR_BG_SUMMARY$COLOR_BOLD$COLOR_LABEL" "$cell_width"
    if [[ "$total" -gt 0 ]]; then
      append_grid_cell "PROGRESS" "$COLOR_BG_SUMMARY$COLOR_BOLD$COLOR_LABEL" "$cell_width"
    fi
    append_grid_cell "SMOOTH" "$COLOR_BG_SUMMARY$COLOR_BOLD$COLOR_LABEL" "$cell_width"
    if [[ "$total" -gt 0 ]]; then
      append_grid_cell "ETA" "$COLOR_BG_SUMMARY$COLOR_BOLD$COLOR_LABEL" "$cell_width"
    fi
    append_grid_cell "CHANGE" "$COLOR_BG_SUMMARY$COLOR_BOLD$COLOR_LABEL" "$last_width"
    fill_grid_background "$cols" "$COLOR_BG_SUMMARY"
    frame_visible[1]="$grid_visible"
    frame_colored[1]="$grid_colored"

    grid_visible=""
    grid_colored=""
    append_grid_cell "$count_display" "$COLOR_BG_SUMMARY$COLOR_VALUE" "$cell_width"
    if [[ "$total" -gt 0 ]]; then
      append_grid_cell "$progress_display" "$COLOR_BG_SUMMARY$COLOR_VALUE" "$cell_width"
    fi
    append_grid_cell "$smooth_display" "$COLOR_BG_SUMMARY$smooth_color" "$cell_width"
    if [[ "$total" -gt 0 ]]; then
      append_grid_cell "$eta_display" "$COLOR_BG_SUMMARY$eta_color" "$cell_width"
    fi
    append_grid_cell "$delta_display" "$COLOR_BG_SUMMARY$change_color" "$last_width"
    fill_grid_background "$cols" "$COLOR_BG_SUMMARY"
    frame_visible[2]="$grid_visible"
    frame_colored[2]="$grid_colored"

    format_scan_activity "$cols"
    frame_visible[3]="$scan_labels_visible"
    frame_colored[3]="$scan_labels_colored"
    frame_visible[4]="$scan_values_visible"
    frame_colored[4]="$scan_values_colored"

    if [[ "$mode" == "file-lines" || "$mode" == "exec" ]]; then
      config_line="${mode} · every ${interval}s · EMA α ${alpha}"
    else
      include_label="files only"
      [[ "$include_dirs" -eq 1 ]] && include_label="files and directories"
      scanner="find"
      [[ "$parallel" -gt 0 ]] && scanner="${parallel} workers"
      config_line="${mode} · pattern ${name_pattern:-*} · every ${interval}s · EMA α ${alpha} · ${include_label} · ${scanner}"
    fi
    frame_visible[5]="$config_line"
    frame_colored[5]="${COLOR_MUTED}${config_line}${COLOR_RESET}"

    header_line="$(format_screen_header "$cols")"
    grid_visible="$header_line"
    grid_colored="${COLOR_BG_HEADER}${COLOR_BOLD}${COLOR_LABEL}${header_line}${COLOR_RESET}"
    fill_grid_background "$cols" "$COLOR_BG_HEADER"
    frame_visible[6]="$grid_visible"
    frame_colored[6]="$grid_colored"

    frame_row=7
    for ((i = start; i < end; i++)); do
      row_text="$(format_screen_sample "${history_rows[$i]}" "$cols")"
      frame_visible[$frame_row]="$row_text"
      if [[ "$i" -eq "$selected_index" ]]; then
        grid_visible="$row_text"
        grid_colored="${COLOR_BG_SELECTED}${row_text}${COLOR_RESET}"
        fill_grid_background "$cols" "$COLOR_BG_SELECTED"
        frame_visible[$frame_row]="$grid_visible"
        frame_colored[$frame_row]="$grid_colored"
      else
        frame_colored[$frame_row]="$row_text"
      fi
      ((frame_row += 1))
    done

    follow_color="$COLOR_YELLOW"
    [[ "$follow" -eq 1 ]] && follow_color="$COLOR_GREEN"
    footer_base="${COLOR_BG_FOOTER}${COLOR_FOOTER_TEXT}"
    footer_key="${COLOR_BG_FOOTER_KEY}${COLOR_FOOTER_KEY}${COLOR_BOLD}"
    footer_quit="${COLOR_BG_FOOTER_QUIT}${COLOR_FOOTER_KEY}${COLOR_BOLD}"
    footer_left="${row_count} samples | selected ${selected_display}/${row_count} | follow ${follow_label} | view ${view_start}/${max_start}"
    footer_left_colored="${footer_base}${row_count} ${COLOR_FOOTER_MUTED}samples${COLOR_FOOTER_TEXT} | ${COLOR_FOOTER_MUTED}selected ${COLOR_FOOTER_TEXT}${selected_display}/${row_count} | ${COLOR_FOOTER_MUTED}follow ${follow_color}${follow_label}${COLOR_FOOTER_TEXT} | ${COLOR_FOOTER_MUTED}view ${COLOR_FOOTER_TEXT}${view_start}/${max_start}"
    footer_right=" k/j  navigate |  t  theme |  h  help |  q  quit"
    footer_right_colored="${footer_key} k/j ${footer_base} navigate | ${footer_key} t ${footer_base} theme | ${footer_key} h ${footer_base} help | ${footer_quit} q ${footer_base} quit"
    # Keep the last terminal column unused so colors are preserved without
    # triggering autowrap at the right edge.
    footer_padding=$((cols - 1 - ${#footer_left} - ${#footer_right}))
    if [[ "$footer_padding" -ge 2 ]]; then
      printf -v footer_line '%s%*s%s' "$footer_left" "$footer_padding" '' "$footer_right"
      printf -v footer_colored '%s%*s%s' "$footer_left_colored" "$footer_padding" '' "$footer_right_colored"
    elif [[ "$cols" -ge 68 ]]; then
      footer_line="${selected_display}/${row_count} selected | ${follow_label} |  k/j |  t theme |  h help |  q quit"
      footer_colored="${footer_base}${selected_display}/${row_count} ${COLOR_FOOTER_MUTED}selected${COLOR_FOOTER_TEXT} | ${follow_color}${follow_label}${COLOR_FOOTER_TEXT} | ${footer_key} k/j ${footer_base}| ${footer_key} t ${footer_base}theme | ${footer_key} h ${footer_base}help | ${footer_quit} q ${footer_base}quit"
    else
      footer_line="${selected_display}/${row_count} | ${follow_label} |  k/j |  t |  h |  q"
      footer_colored="${footer_base}${selected_display}/${row_count} | ${follow_color}${follow_label}${COLOR_FOOTER_TEXT} | ${footer_key} k/j ${footer_base}| ${footer_key} t ${footer_base}| ${footer_key} h ${footer_base}| ${footer_quit} q ${footer_base}"
    fi
    grid_visible="$footer_line"
    grid_colored="${footer_colored}${COLOR_RESET}"
    fill_grid_background "$cols" "$COLOR_BG_FOOTER"
    frame_visible[$((rows - 2))]="$grid_visible"
    frame_colored[$((rows - 2))]="$grid_colored"
  fi

  if [[ "${screen_prev_rows:-0}" -ne "$rows" || "${screen_prev_cols:-0}" -ne "$cols" ]]; then
    force_redraw=1
    screen_prev_visible=()
    screen_prev_colored=()
    # A resize can leave rows from the old (often taller) layout on screen —
    # e.g. a footer drawn at a row position that is now mid-body or beyond the
    # new terminal height. Nothing below redraws those leftover rows, so clear
    # the whole screen before repainting at the new size.
    printf '\033[2J'
  fi

  printf '\033[?2026h'
  for ((i = 0; i < rows - 1; i++)); do
    visible="${frame_visible[$i]:-}"
    colored="${frame_colored[$i]:-$visible}"
    previous_visible="${screen_prev_visible[$i]:-}"
    previous_colored="${screen_prev_colored[$i]:-}"
    if [[ "$force_redraw" -eq 1 || "$visible" != "$previous_visible" || "$colored" != "$previous_colored" ]]; then
      draw_screen_row "$((i + 1))" "$visible" "$colored" "$cols"
      screen_prev_visible[$i]="$visible"
      screen_prev_colored[$i]="$colored"
    fi
  done
  printf '\033[?2026l'
  screen_prev_rows="$rows"
  screen_prev_cols="$cols"
}

# Handle one keypress from /dev/tty. Returns non-zero only when the monitor
# should quit; q in help closes help instead of exiting.
handle_key() {
  local key page_rows

  read_input_event || return 0
  if [[ "$input_event" == "theme" ]]; then
    screen_needs_render=1
    return 0
  fi
  [[ "$input_event" == "key" ]] || return 0
  key="$input_value"
  page_rows=$(($(terminal_rows) - 9))
  [[ "$page_rows" -gt 0 ]] || page_rows=1

  case "$key" in
    q)
      if [[ "$show_help" -eq 1 ]]; then
        screen_needs_render=1
        show_help=0
        return 0
      fi
      return 1
      ;;
    h | \?)
      screen_needs_render=1
      if [[ "$show_help" -eq 1 ]]; then
        show_help=0
      else
        show_help=1
      fi
      ;;
    t)
      if [[ "$screen_theme" == "dark" ]]; then
        set_screen_theme "light"
      else
        set_screen_theme "dark"
      fi
      screen_needs_render=1
      ;;
    k)
      screen_needs_render=1
      show_help=0
      follow=0
      selected_index=$((selected_index - 1))
      ;;
    j)
      screen_needs_render=1
      show_help=0
      selected_index=$((selected_index + 1))
      ;;
    g)
      screen_needs_render=1
      show_help=0
      follow=0
      selected_index=0
      ;;
    G)
      screen_needs_render=1
      show_help=0
      follow=1
      selected_index=$((${#history_rows[@]} - 1))
      ;;
    $'\033')
      if [[ "$show_help" -eq 1 ]]; then
        screen_needs_render=1
        show_help=0
      fi
      ;;
    $'\033[A')
      screen_needs_render=1
      show_help=0
      follow=0
      selected_index=$((selected_index - 1))
      ;;
    $'\033[B')
      screen_needs_render=1
      show_help=0
      selected_index=$((selected_index + 1))
      ;;
    $'\033[5~')
      screen_needs_render=1
      show_help=0
      follow=0
      selected_index=$((selected_index - page_rows))
      ;;
    $'\033[6~')
      screen_needs_render=1
      show_help=0
      selected_index=$((selected_index + page_rows))
      ;;
    $'\033[F' | $'\033[4~' | $'\033[8~')
      screen_needs_render=1
      show_help=0
      follow=1
      selected_index=$((${#history_rows[@]} - 1))
      ;;
    $'\033[H' | $'\033[1~' | $'\033[7~')
      screen_needs_render=1
      show_help=0
      follow=0
      selected_index=0
      ;;
  esac

  clamp_selection "$page_rows"
  return 0
}

# Add the latest sample_line to screen history and drop oldest retained rows when
# --history is exceeded.
append_history() {
  history_rows+=("$sample_line")
  while [[ "${#history_rows[@]}" -gt "$history_limit" ]]; do
    history_rows=("${history_rows[@]:1}")
    if [[ "$selected_index" -gt 0 ]]; then
      selected_index=$((selected_index - 1))
    fi
    if [[ "$view_start" -gt 0 ]]; then
      view_start=$((view_start - 1))
    fi
  done
  if [[ "$follow" -eq 1 ]]; then
    selected_index=$((${#history_rows[@]} - 1))
  fi
}

# Interactive screen UI: async counting, fixed header, retained-history scrolling.
run_screen() {
  local next_scan_time now cols
  setup_screen
  start_async_scan
  render_screen
  next_scan_time=$((SECONDS + interval))

  while true; do
    if ! handle_key; then
      break
    fi
    if [[ "${screen_resized:-0}" -eq 1 ]]; then
      screen_resized=0
      screen_needs_render=1
    fi
    if refresh_scan_progress && [[ "$show_help" -eq 0 ]]; then
      cols="$(terminal_cols)"
      format_scan_activity "$cols"
      if [[ "$scan_values_visible" != "${screen_prev_visible[4]:-}" || "$scan_values_colored" != "${screen_prev_colored[4]:-}" ]]; then
        printf '\033[?2026h'
        draw_screen_row 5 "$scan_values_visible" "$scan_values_colored" "$cols"
        printf '\033[?2026l'
        screen_prev_visible[4]="$scan_values_visible"
        screen_prev_colored[4]="$scan_values_colored"
      fi
    fi
    if [[ "$screen_needs_render" -eq 1 ]]; then
      render_screen
      screen_needs_render=0
    fi

    now="$SECONDS"
    if collect_async_scan; then
      append_history
      ((printed += 1))
      render_screen

      if [[ "$samples" -gt 0 && "$printed" -ge "$samples" ]]; then
        break
      fi
      next_scan_time=$((now + interval))
    fi

    if [[ -z "${scan_pid:-}" && "$now" -ge "$next_scan_time" ]]; then
      start_async_scan
      render_screen
    fi

  done

  cleanup_screen
}

parse_args "$@"
validate_args

# Exec mode has no path to wait for or validate; the command string doubles
# as the display target in the title line.
if [[ -n "$exec_cmd" ]]; then
  target="$exec_cmd"
  mode="exec"
else
  if ! wait_for_target; then
    exit 0
  fi
  validate_target
fi

if [[ -n "$exec_cmd" ]]; then
  : # mode already set above
elif [[ -d "$target" ]]; then
  target="$(cd "$target" && pwd -P)"
  mode="recursive"
  [[ "$recursive" -eq 1 ]] || mode="non-recursive"
else
  target_dir="$(cd "$(dirname "$target")" && pwd -P)"
  target="${target_dir}/$(basename "$target")"
  mode="file-lines"
fi

case "$ui" in
  append)
    initial_scan_start="$(date +%s)"
    prev_count="$(count_target)"
    initial_count="$prev_count"
    prev_time="$(date +%s)"
    initial_scan_s=$((prev_time - initial_scan_start))
    smooth="0"
    printed=0
    sample_line=""
    run_append
    ;;
  screen)
    prev_count=0
    initial_count="pending"
    prev_time="$(date +%s)"
    initial_scan_s=0
    smooth="0"
    printed=0
    sample_line=""
    saved_stty=""
    scan_pid=""
    scan_file=""
    scan_progress_file=""
    scan_status="idle"
    scan_folders_scanned=0
    scan_folders_discovered=1
    scan_tracks_folders=0
    if [[ "$mode" == "recursive" && "$parallel" -gt 0 ]] && command -v python3 >/dev/null 2>&1; then
      scan_tracks_folders=1
    fi
    screen_has_baseline=0
    current_scan_s="--"
    current_count="pending"
    current_delta=0
    screen_prev_rows=0
    screen_prev_cols=0
    declare -a screen_prev_visible=()
    declare -a screen_prev_colored=()
    declare -a history_rows=()
    follow=1
    selected_index=-1
    view_start=0
    screen_needs_render=0
    show_help=0
    run_screen
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
update=0; preview=0; args=()
for arg in "$@"; do
  case "$arg" in
    -u|-U|--update) update=1 ;;
    -n|--dry-run) preview=1; args+=(--dry-run) ;;
    -h|--help)
      cat <<'HELP'
Usage: ./install [--dry-run] [--update] [mise bootstrap options]
Installs mise if needed, registers this checkout globally, then runs mise bootstrap.
  --only dotfiles    Deploy configuration/persistent links without tool downloads
  --only tools       Install declared tools
  --skip repos      Skip shell framework clones/initialization
  --dry-run         Preview bootstrap; no HOME changes (mise may download to /tmp)
  --update          Fast-forward public and existing private repos before bootstrap
Other arguments go to mise bootstrap. Default run never pulls Git repositories.
HELP
      exit 0 ;;
    *) args+=("$arg") ;;
  esac
done
if ((update)); then
  if ((preview)); then echo 'Would git pull --ff-only public and private repositories';
  else
    git -C "$root" pull --ff-only
    update_private="${DOTFILES_CUSTOM_ROOT:-$root/persistent/custom}"
    if [[ -d "$update_private/.git" || -f "$update_private/.git" ]]; then
      git -C "$update_private" pull --ff-only
    fi
  fi
fi
# Preview keeps downloads and mise trust/cache writes outside the real HOME.
if ((preview)); then
  temp="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-preview.XXXXXX")"
  trap 'rm -rf "$temp"' EXIT
  export MISE_INSTALL_DIR="$temp/bin" MISE_DATA_DIR="$temp/data" MISE_CACHE_DIR="$temp/cache" MISE_STATE_DIR="$temp/state"
  export XDG_CONFIG_HOME="$temp/config"
fi
source "$root/mise/scripts/ensure-mise"
ensure_mise
export PATH="$(dirname "$MISE_BIN"):$PATH"
if ((preview)); then
  echo "Would register this public checkout and its optional private mise.toml"
fi
if ((!preview)); then bash "$root/mise/scripts/custom-root"; fi
# In preview this registration lives entirely under the temporary config directory.
bash "$root/mise/scripts/register"
# Explicit installer invocation authorizes only this checkout, never every config.
"$MISE_BIN" trust "$root/mise.toml"
deploy_dotfiles=1
previous=''
for arg in "${args[@]}"; do
  value="$arg"
  if [[ "$previous" == --only || "$arg" == --only=* ]]; then
    value="${value#--only=}"
    case ",$value," in *,dotfiles,*) deploy_dotfiles=1 ;; *) deploy_dotfiles=0 ;; esac
  elif [[ "$previous" == --skip || "$arg" == --skip=* ]]; then
    value="${value#--skip=}"
    case ",$value," in *,dotfiles,*) deploy_dotfiles=0 ;; esac
  fi
  previous="$arg"
done
for private in "$root/persistent" "${DOTFILES_CUSTOM_ROOT:-$root/persistent/custom}"; do
  if ((deploy_dotfiles)) && [[ -f "$private/install.conf.yaml" && ! -f "$private/mise.toml" ]]; then
    echo 'Private Dotbot config found; migrate before applying (see mise/README.md):' >&2
    echo "  python3 $root/mise/scripts/migrate-private $private/install.conf.yaml" >&2
    echo 'Stopping before bootstrap so private setup is not silently omitted.' >&2
    exit 1
  fi
done
# Use global fragment order (public, private, user), also when invoked from the checkout.
export DOTFILES_ROOT="$root"
cd "$HOME"
"$MISE_BIN" bootstrap --yes --skip-dirty "${args[@]}"

#!/usr/bin/env bash
# Bootstrap only mise itself and config registration; mise owns everything else.
set -euo pipefail
root="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  printf '%s\n' 'Usage: ./install [mise bootstrap options]' \
    'Use mise install, mise dot apply, mise bootstrap and mise run directly afterwards.' \
    'DOTFILES_CUSTOM_ROOT selects an independent private repo with its own mise.toml.'
  exit 0
fi
for arg in "$@"; do
  if [[ "$arg" == --dry-run || "$arg" == -n ]]; then
    temp="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-preview.XXXXXX")"
    trap 'rm -rf "$temp"' EXIT
    export MISE_INSTALL_DIR="$temp/bin" MISE_DATA_DIR="$temp/data" MISE_CACHE_DIR="$temp/cache" MISE_STATE_DIR="$temp/state"
    export XDG_CONFIG_HOME="$temp/config"
    break
  fi
done
source "$root/mise/scripts/ensure-mise"
ensure_mise
export PATH="$(dirname "$MISE_BIN"):$PATH"
bash "$root/mise/scripts/register"
cd "$HOME"
exec_args=(bootstrap --yes --skip-dirty "$@")
# Do not exec: preview cleanup must run after mise exits.
"$MISE_BIN" "${exec_args[@]}"
